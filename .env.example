# Core
ENV=dev
PUBLIC_BASE_URL=http://localhost:8000
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/commerce_agent
REDIS_URL=redis://redis:6379/0
SECRET_KEY=change-me-use-openssl-rand-hex-32
FERNET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Shopify app credentials
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_API_VERSION=2026-04
SHOPIFY_SCOPES=read_products,write_products

# AI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
MOCK_LLM=false

# Usage limits
FREE_MONTHLY_CREDITS=50
PRO_MONTHLY_CREDITS=5000
BUSINESS_MONTHLY_CREDITS=50000
ENFORCE_USAGE_LIMITS=true

# Stripe, optional for MVP dev
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=

# Dev convenience. Set true to execute Celery tasks in-process.
CELERY_ALWAYS_EAGER=false
